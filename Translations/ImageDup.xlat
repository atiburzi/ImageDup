      <module name="TFORMABOUT" type="form">
        <items>
          <item name="FormAbout" type="TFormAbout">
            <properties>
              <property name="Caption">
                <value>About ImageDup</value>
                <translations>
                  <translation language="it-IT" status="proposed">Informazioni su ImageDup</translation>
                </translations>
              </property>
              <property name="Font.Name" status="skip">
                <value>Segoe UI</value>
              </property>
            </properties>
          </item>
          <item name="FormAbout.CloseButton" type="TButton">
            <properties>
              <property name="Caption">
                <value>OK</value>
                <translations>
                  <translation language="it-IT" status="proposed">OK</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="FormAbout.DescriptionLabel" type="TLabel">
            <properties>
              <property name="Caption">
                <value>Find and compare visually similar images.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Trova e confronta immagini visivamente simili.</translation>
                </translations>
              </property>
              <property name="Font.Name" status="skip">
                <value>Segoe UI</value>
              </property>
            </properties>
          </item>
          <item name="FormAbout.DetailLabel" type="TLabel">
            <properties>
              <property name="Caption">
                <value>Quality ranking, grouped results, session management, Excel export, and safe duplicate selection.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Classifica per qualità, risultati raggruppati, gestione delle sessioni, esportazione in Excel e selezione sicura dei duplicati.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="FormAbout.ProductLabel" type="TLabel">
            <properties>
              <property name="Caption">
                <value>ImageDup</value>
                <translations>
                  <translation language="it-IT" status="proposed">ImageDup</translation>
                </translations>
              </property>
              <property name="Font.Name" status="skip">
                <value>Segoe UI</value>
              </property>
            </properties>
          </item>
          <item name="FormAbout.VersionLabel" type="TLabel">
            <properties>
              <property name="Caption">
                <value>Version 1.0.0.0</value>
                <translations>
                  <translation language="it-IT" status="proposed">Versione 1.0.0.0</translation>
                </translations>
              </property>
            </properties>
          </item>
        </items>
      </module>
      <module name="TFORMMAIN" type="form">
        <items>
          <item name="FormMain" type="TFormMain">
            <properties>
              <property name="Caption">
                <value>ImageDup</value>
                <translations>
                  <translation language="it-IT" status="proposed">ImageDup</translation>
                </translations>
              </property>
              <property name="Font.Name" status="skip">
                <value>Segoe UI</value>
              </property>
            </properties>
          </item>
          <item name="FormMain.ActionList.ActionAbout" type="TAction">
            <properties>
              <property name="Caption">
