          <item name="ImageDup_Core_rsImageDecoderUnavailable">
            <properties>
              <property>
                <value>No Windows WIC decoder is available for %s. Install or enable a compatible image extension (WebP or HEIF/HEVC for those formats).</value>
                <translations>
                  <translation language="it-IT" status="proposed">Per %s non è disponibile alcun decodificatore WIC di Windows. Installare o abilitare un'estensione immagine compatibile (WebP o HEIF/HEVC per quei formati).</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="ImageDup_Core_rsImageTooLarge">
