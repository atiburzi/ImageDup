                <translations>
                  <translation language="it-IT" status="proposed">File immagine JPEG</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EInvalidNewSize">
            <properties>
              <property>
                <value>The new size provided for image resizing is invalid.</value>
                <translations>
                  <translation language="it-IT" status="proposed">La nuova dimensione specificata per il ridimensionamento dell'immagine non è valida.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EInvalidSpec">
            <properties>
              <property>
                <value>The "Portable Network Graphics" could not be created because invalid image type parameters have being provided.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Non è stato possibile creare il file "Portable Network Graphics" perché sono stati forniti parametri di tipo immagine non validi.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGCannotAddChunkText">
            <properties>
              <property>
                <value>The program tried to add a existent critical chunk to the current image which is not allowed.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Il programma ha tentato di aggiungere un blocco critico esistente all'immagine corrente, operazione non consentita.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGCannotAddInvalidImageText">
            <properties>
              <property>
                <value>It's not allowed to add a new chunk because the current image is invalid.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Non è possibile aggiungere un nuovo chunk perché l'immagine corrente non è valida.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGCannotAssignChunkText">
            <properties>
              <property>
                <value>The chunks must be compatible to be assigned.</value>
                <translations>
                  <translation language="it-IT" status="proposed">I blocchi devono essere compatibili per poter essere assegnati.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGCannotChangeTransparentText">
            <properties>
              <property>
                <value>Setting bit transparency color is not allowed for png images containing alpha value for each pixel (COLOR_RGBALPHA and COLOR_GRAYSCALEALPHA)</value>
                <translations>
                  <translation language="it-IT" status="proposed">Non è consentito impostare il colore di trasparenza dei bit per le immagini PNG che contengono un valore alfa per ciascun pixel (COLOR_RGBALPHA e COLOR_GRAYSCALEALPHA)</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGCouldNotLoadResourceText">
            <properties>
              <property>
                <value>The png image could not be loaded from the resource ID.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Impossibile caricare l'immagine PNG dall'ID della risorsa.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGHeaderNotPresentText">
            <properties>
              <property>
                <value>This operation is not valid because the current image contains no valid header.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Questa operazione non è valida perché l'immagine corrente non contiene un'intestazione valida.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGIHDRNotFirstText">
            <properties>
              <property>
                <value>This "Portable Network Graphics" image is not supported or it might be invalid.&amp;#13;&amp;#10;(IHDR chunk is not the first)</value>
                <translations>
                  <translation language="it-IT" status="proposed">Questa immagine "Portable Network Graphics" non è supportata o potrebbe essere non valida.&amp;#10;(Il blocco IHDR non è il primo)</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGInvalidBitDepthText">
            <properties>
              <property>
                <value>The "Portable Network Graphics" image could not be loaded because it uses an invalid image bit depth.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Non è stato possibile caricare l'immagine "Portable Network Graphics" perché utilizza una profondità di bit non valida.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPngInvalidCRCText">
            <properties>
              <property>
                <value>This "Portable Network Graphics" image is not valid because it contains invalid pieces of data (crc error)</value>
                <translations>
                  <translation language="it-IT" status="proposed">Questa immagine "Portable Network Graphics" non è valida perché contiene dati non validi (errore CRC)</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGInvalidFileHeaderText">
            <properties>
              <property>
                <value>The file being read is not a valid "Portable Network Graphics" image because it contains an invalid header. This file may be corrupted, try obtaining it again</value>
                <translations>
                  <translation language="it-IT" status="proposed">Il file in fase di lettura non è un'immagine "Portable Network Graphics" valida perché contiene un'intestazione non valida. Il file potrebbe essere danneggiato; prova a scaricarlo di nuovo.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGInvalidIHDRText">
            <properties>
              <property>
                <value>The "Portable Network Graphics" image could not be loaded because one of its main piece of data (ihdr) might be corrupted</value>
                <translations>
                  <translation language="it-IT" status="proposed">Non è stato possibile caricare l'immagine "Portable Network Graphics" perché uno dei suoi dati principali (ihdr) potrebbe essere danneggiato</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGInvalidPaletteText">
            <properties>
              <property>
                <value>The "Portable Network Graphics" image contains an invalid palette.</value>
                <translations>
                  <translation language="it-IT" status="proposed">L'immagine "Portable Network Graphics" contiene una tavolozza non valida.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGMissingMultipleIDATText">
            <properties>
              <property>
                <value>This "Portable Network Graphics" image is invalid because it has missing image parts.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Questa immagine "Portable Network Graphics" non è valida perché presenta parti mancanti.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGNoImageDataText">
            <properties>
              <property>
                <value>This "Portable Network Graphics" image contains no data.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Questa immagine "Portable Network Graphics" non contiene dati.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGOutMemoryText">
            <properties>
              <property>
                <value>Some operation could not be performed because the system is out of resources. Close some windows and try again.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Non è stato possibile eseguire un'operazione perché il sistema ha esaurito le risorse. Chiudi alcune finestre e riprova.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGSizeExceedsText">
            <properties>
              <property>
                <value>This "Portable Network Graphics" image is not supported because either its width or height exceeds the maximum size of 65535 pixels.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Questa immagine in formato "Portable Network Graphics" non è supportata poiché la sua larghezza o la sua altezza supera la dimensione massima di 65535 pixel.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGUnexpectedEndText">
            <properties>
              <property>
                <value>This "Portable Network Graphics" image is invalid because the decoder found an unexpected end of the file.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Questa immagine "Portable Network Graphics" non è valida perché il decodificatore ha rilevato una fine inaspettata del file.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGUnknownColorTypeText">
            <properties>
              <property>
                <value>This "Portable Network Graphics" image uses an unknown color type which could not be decoded.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Questa immagine "Portable Network Graphics" utilizza un tipo di colore sconosciuto che non è stato possibile decodificare.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGUnknownCompressionText">
            <properties>
              <property>
                <value>This "Portable Network Graphics" image is encoded with an unknown compression scheme which could not be decoded.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Questa immagine "Portable Network Graphics" è codificata con uno schema di compressione sconosciuto che non è stato possibile decodificare.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGUnknownCriticalChunkText">
            <properties>
              <property>
                <value>This "Portable Network Graphics" image contains an unknown critical part which could not be decoded.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Questa immagine "Portable Network Graphics" contiene una parte critica non identificata che non è stato possibile decodificare.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGUnknownInterlaceText">
            <properties>
              <property>
                <value>This "Portable Network Graphics" image uses an unknown interlace scheme which could not be decoded.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Questa immagine in formato "Portable Network Graphics" utilizza uno schema di interlacciamento sconosciuto che non è stato possibile decodificare.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGUnknownPalEntryText">
            <properties>
              <property>
                <value>There is no such palette entry.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Non esiste una voce di questo tipo nella tavolozza.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="Vcl_Imaging_pnglang_EPNGZLIBErrorText">
            <properties>
              <property>
                <value>Could not decompress the image because it contains invalid compressed data.&amp;#13;&amp;#10; Description: </value>
                <translations>
                  <translation language="it-IT" status="proposed">Impossibile decomprimere l'immagine poiché contiene dati compressi non validi.&amp;#10; Descrizione: </translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="VirtualTrees_AncestorVCL_SClipboardFailed">
            <properties>
              <property>
                <value>Clipboard operation failed.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Operazione sugli appunti non riuscita.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="VirtualTrees_BaseTree_SCorruptStream1">
            <properties>
              <property>
                <value>Stream data corrupt. A node's anchor chunk is missing.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Dati dello stream danneggiati. Manca il chunk di ancoraggio di un nodo.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="VirtualTrees_BaseTree_SCorruptStream2">
            <properties>
              <property>
                <value>Stream data corrupt. Unexpected data after node's end position.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Dati del flusso danneggiati. Dati inattesi dopo la posizione finale del nodo.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="VirtualTrees_BaseTree_SStreamTooSmall">
            <properties>
              <property>
                <value>Unable to load tree structure, not enough data available.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Impossibile caricare la struttura ad albero: dati disponibili insufficienti.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="VirtualTrees_BaseTree_SWrongMoveError">
            <properties>
              <property>
                <value>Target node cannot be a child node of the node to be moved.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Il nodo di destinazione non può essere un nodo figlio del nodo da spostare.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="VirtualTrees_BaseTree_SWrongStreamFormat">
            <properties>
              <property>
                <value>Unable to load tree structure, the format is wrong.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Impossibile caricare la struttura ad albero: il formato è errato.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="VirtualTrees_BaseTree_SWrongStreamVersion">
            <properties>
              <property>
                <value>Unable to load tree structure, the version is unknown.</value>
                <translations>
                  <translation language="it-IT" status="proposed">Impossibile caricare la struttura ad albero; la versione è sconosciuta.</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="VirtualTrees_HeaderPopup_sResizeColumnToFit">
            <properties>
              <property>
                <value>Size &amp;Column to Fit</value>
                <translations>
                  <translation language="it-IT" status="proposed">Adatta la dimensione della &amp;colonna</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="VirtualTrees_HeaderPopup_sResizeToFit">
            <properties>
              <property>
                <value>Size &amp;All Columns to Fit</value>
                <translations>
                  <translation language="it-IT" status="proposed">Ridimension&amp;a tutte le colonne</translation>
                </translations>
              </property>
            </properties>
          </item>
        </items>
      </module>
