              </property>
            </properties>
          </item>
          <item name="FormSettings.AppearanceGroupBox.ThemeDescriptionLabel" type="TLabel">
            <properties>
              <property name="Caption">
                <value>Choose the visual theme used by the main window and every open session. The selection is restored when ImageDup starts.</value>
              </property>
            </properties>
          </item>
          <item name="FormSettings.AppearanceGroupBox.ThemeLabel" type="TLabel">
            <properties>
