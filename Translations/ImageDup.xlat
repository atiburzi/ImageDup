                <value> Scanning </value>
              </property>
            </properties>
          </item>
          <item name="FormSettings.ScanningGroupBox.ThreadDescriptionLabel" type="TLabel">
            <properties>
              <property name="Caption">
                <value>The maximum number of threads depends on this computer.</value>
              </property>
            </properties>
          </item>
          <item name="FormSettings.ScanningGroupBox.ThreadLabel" type="TLabel">
            <properties>
              <property name="Caption">
