          <item name="OptionsForm.ButtonsPanel.OKButton" type="TButton">
            <properties>
              <property name="Caption">
                <value>OK</value>
                <translations>
                  <translation language="it-IT" status="proposed">OK</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="OptionsForm.IncludeSingletonsCheck" type="TCheckBox" state="unused">
            <properties>
              <property name="Caption">
                <value>Include groups without duplicates (single file)</value>
                <translations>
                  <translation language="it-IT" status="proposed">Includi i gruppi senza duplicati (file singolo)</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="OptionsForm.MatchingGroupBox" type="TGroupBox">
            <properties>
              <property name="Caption">
                <value> Image comparison </value>
              </property>
            </properties>
          </item>
          <item name="OptionsForm.MatchingGroupBox.QualityDescriptionLabel" type="TLabel">
            <properties>
              <property name="Caption">
                <value>Controls how closely images must resemble one another. Lower values find more variations; higher values accept only closer visual matches.</value>
              </property>
            </properties>
          </item>
          <item name="OptionsForm.MatchingGroupBox.QualityLabel" type="TLabel">
            <properties>
              <property name="Caption">
                <value>Matching quality</value>
              </property>
            </properties>
          </item>
          <item name="OptionsForm.QualityLabel" type="TLabel" state="unused">
            <properties>
              <property name="Caption">
                <value>Matching quality index (0 - Low, 10- High)</value>
                <translations>
                  <translation language="it-IT" status="proposed">Qualità della corrispondenza (0 -Basso, 10 - Alto)</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="OptionsForm.RecursiveCheck" type="TCheckBox" state="unused">
            <properties>
              <property name="Caption">
                <value>Include subfolders in the search</value>
                <translations>
                  <translation language="it-IT" status="proposed">Includi le sottocartelle nella ricerca</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="OptionsForm.SearchScopeGroupBox" type="TGroupBox">
            <properties>
              <property name="Caption">
                <value> Search scope </value>
              </property>
            </properties>
          </item>
          <item name="OptionsForm.SearchScopeGroupBox.IncludeSingletonsCheck" type="TCheckBox">
            <properties>
              <property name="Caption">
                <value>Include groups without duplicates (single file)</value>
                <translations>
                  <translation language="it-IT" status="proposed">Includi i gruppi senza duplicati (file singolo)</translation>
                </translations>
              </property>
            </properties>
          </item>
          <item name="OptionsForm.SearchScopeGroupBox.IncludeSingletonsDescriptionLabel" type="TLabel">
            <properties>
              <property name="Caption">
                <value>Also show images that did not match any other file, as groups containing one item.</value>
              </property>
            </properties>
          </item>
          <item name="OptionsForm.SearchScopeGroupBox.RecursiveCheck" type="TCheckBox">
            <properties>
              <property name="Caption">
