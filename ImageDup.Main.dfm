      Enabled = False
      Hint = 'Sposta nel Cestino di Windows i file selezionati'
      ImageIndex = 2
      ImageName = 'delete'
      OnExecute = DeleteSelectedButtonClick
    end
    object ActionSelectionOptions: TAction
      Caption = 'Selezioni'
      Enabled = False
      Hint = 'Apre le opzioni di selezione automatica'
      ImageIndex = 1
      ImageName = 'check'
      OnExecute = SelectionButtonClick
    end
    object ActionSelectSmallest: TAction
      Caption = 'Seleziona il file più piccolo in ogni gruppo'
      OnExecute = SelectSmallestClick
    end
    object ActionSelectLowerResolution: TAction
      Caption = 'Seleziona la risoluzione inferiore in ogni gruppo'
      OnExecute = SelectLowerResolutionClick
    end
    object ActionSelectLowerQuality: TAction
      Caption = 'Seleziona i file con qualità inferiore in ogni gruppo'
      OnExecute = SelectLowerQualityClick
    end
    object ActionSelectIdenticalToReference: TAction
      Caption = 'Seleziona i file identici a quello di riferimento'
      OnExecute = SelectIdenticalToReferenceClick
    end
    object ActionSelectOldest: TAction
      Caption = 'Seleziona il file meno recente in ogni gruppo'
      OnExecute = SelectOldestClick
    end
    object ActionEnsureUnselected: TAction
      Caption = 'Assicura almeno un file non selezionato per gruppo'
      OnExecute = EnsureUnselectedClick
    end
    object ActionDeselectAll: TAction
      Caption = 'Deseleziona tutto'
      OnExecute = DeselectAllClick
    end
  end
end


